generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite unterstützt keine Enums – als String gespeichert
// Pseudonyme Benutzer
model User {
  id             String    @id @default(cuid())
  username       String    @unique
  
  // Email optional, minimales Auth
  email          String?   @unique
  passwordHash   String
  
  // Privacy: Zone statt exakte Koordinaten
  locationZone   String?
  
  role           String    @default("CONSUMER")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  listings       Listing[]
  purchases      Purchase[]

  @@index([role])
  @@index([createdAt])
}

// Angebote
model Listing {
  id                String    @id @default(cuid())
  providerId        String
  
  title             String
  description       String?
  
  quantityAvailable Int
  unit              String    @default("Stück")
  
  // Preisgestaffeln als JSON (als String in SQLite)
  priceTiers        String    // JSON: [{qty: 1, pricePerUnit: 5}, ...]
  
  // Privacy: Zone
  locationZone      String
  
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?
  
  provider          User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  purchases         Purchase[]

  @@index([providerId])
  @@index([isActive])
  @@index([locationZone])
}

// Käufe / Anfragen
model Purchase {
  id             String   @id @default(cuid())
  consumerId     String
  listingId      String
  
  quantity       Int
  agreedPrice    Float
  status         String   @default("PENDING")
  
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  
  consumer       User     @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  @@index([consumerId])
  @@index([listingId])
  @@index([status])
}

// Scientific studies (automated ingestion pipeline)
model Study {
  id             String   @id @default(uuid())
  title          String
  doi            String   @unique
  abstract       String
  authors        String   // JSON array of author names
  journal        String
  year           Int
  source         String   // "pubmed", "semantic", or "crossref"
  category       String   // "medical", "chemistry", "regulation", "cultivation"
  qualityScore   Float
  relevanceScore Float
  citationCount  Int
  createdAt      DateTime @default(now())

  @@index([source])
  @@index([category])
  @@index([qualityScore])
  @@index([createdAt])
}

// Audit Logs - minimal, mit Ablauf
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  metadata   String?
  
  createdAt  DateTime @default(now())
  expiresAt  DateTime // Nach 90 Tagen löschen
  
  @@index([action])
  @@index([expiresAt])
}
