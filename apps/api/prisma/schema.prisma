generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite unterstützt keine Enums – als String gespeichert
// Pseudonyme Benutzer
model User {
  id             String    @id @default(cuid())
  username       String    @unique
  
  // Email optional, minimales Auth
  email          String?   @unique
  passwordHash   String
  
  // Privacy: Zone statt exakte Koordinaten
  locationZone   String?
  
  role           String    @default("CONSUMER")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  listings       Listing[]
  purchases      Purchase[]

  @@index([role])
  @@index([createdAt])
}

// Angebote
model Listing {
  id                String    @id @default(cuid())
  providerId        String
  
  title             String
  description       String?
  
  quantityAvailable Int
  unit              String    @default("Stück")
  
  // Preisgestaffeln als JSON (als String in SQLite)
  priceTiers        String    // JSON: [{qty: 1, pricePerUnit: 5}, ...]
  
  // Privacy: Zone
  locationZone      String
  
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?
  
  provider          User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  purchases         Purchase[]

  @@index([providerId])
  @@index([isActive])
  @@index([locationZone])
}

// Käufe / Anfragen
model Purchase {
  id             String   @id @default(cuid())
  consumerId     String
  listingId      String
  
  quantity       Int
  agreedPrice    Float
  status         String   @default("PENDING")
  
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  
  consumer       User     @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  @@index([consumerId])
  @@index([listingId])
  @@index([status])
}

// Scientific studies (automated ingestion pipeline)
model Study {
  id             String   @id @default(uuid())
  title          String
  doi            String   @unique
  abstract       String
  authors        String   // JSON array of author names
  journal        String
  year           Int
  source         String   // "pubmed", "semantic", or "crossref"
  category       String   // "medical", "chemistry", "regulation", "cultivation"
  qualityScore   Float
  relevanceScore Float
  citationCount  Int
  createdAt      DateTime @default(now())

  @@index([source])
  @@index([category])
  @@index([qualityScore])
  @@index([createdAt])
}

// ─── Wiki ────────────────────────────────────────────────────────────────────

// Wiki articles (migrated from static wiki.ts)
model WikiArticle {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  category    String             // e.g. "grundlagen", "anbau", "medizin", "recht"
  summary     String
  content     String             // JSON: structured sections / paragraphs
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  articleSources WikiArticleSource[]

  @@index([slug])
  @@index([category])
}

// Scientific / study sources (pmid, doi, external link)
model WikiSource {
  id        String             @id @default(cuid())
  title     String
  publisher String?
  doi       String?            @unique
  pmid      String?            @unique
  url       String?
  year      Int?
  createdAt DateTime           @default(now())

  articleSources WikiArticleSource[]

  @@index([doi])
  @@index([pmid])
}

// Many-to-many join: which sources are cited by which articles
model WikiArticleSource {
  articleId String
  sourceId  String

  article WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source  WikiSource  @relation(fields: [sourceId],  references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
  @@index([sourceId])
}

// ─── Fertilizer catalog ──────────────────────────────────────────────────────

model Fertilizer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String?
  description String?
  usage       String?  // application / dosage instructions
  npk         String?  // JSON: { "n": 10, "p": 5, "k": 8 }
  ec          Float?   // recommended EC value
  phMin       Float?   // recommended pH range – lower bound
  phMax       Float?   // recommended pH range – upper bound
  category    String?  // "grow", "bloom", "additive", "substrate", …
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brand])
  @@index([category])
}

// ─── Audit Logs - minimal, mit Ablauf ────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  userId     String?
  metadata   String?
  
  createdAt  DateTime @default(now())
  expiresAt  DateTime // Nach 90 Tagen löschen
  
  @@index([action])
  @@index([expiresAt])
}
