# Copy to .env.local and adjust

# Browser Supabase client (required for auth/features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
# Optional fallback key name supported by code:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase client (required for /api/health and server routes)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=change-me-long-random-string

# Optional runtime URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STATUS_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: minimum retry delay for stored automation errors
AUTOMATION_ERROR_MEMORY_MIN_DELAY_MINUTES=60

# Stripe (required for /pricing checkout + Pro entitlements)
# Get keys from https://dashboard.stripe.com/apikeys (test mode while developing)
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint's "Signing secret" in the Stripe Dashboard, or
# from `stripe listen` output when testing locally
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from the Pro product's pricing table in the Stripe Dashboard
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_YEARLY=price_...

# Transactional email (Supabase Send Email Hook -> Brevo). See
# docs/EMAIL_TEMPLATES_PLAN.md. Without these the /api/auth/send-email hook
# 500s and auth mails don't go out (disable the hook in Supabase to fall
# back to the built-in templates + custom SMTP).
BREVO_API_KEY=xkeysib-...
# Supabase Dashboard -> Auth -> Hooks -> Send Email Hook -> generated secret
SEND_EMAIL_HOOK_SECRET=v1,whsec_...
EMAIL_FROM=noreply@secretleaf.net
EMAIL_FROM_NAME=SecretLeaf
EMAIL_REPLY_TO=contact@secretleaf.net
