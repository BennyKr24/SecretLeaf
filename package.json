{
  "name": "secretleaf-platform",
  "private": true,
  "version": "1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @secretleaf/web",
    "dev:api": "npm run dev --workspace @secretleaf/api",
    "build": "npm run build --workspace @secretleaf/web",
    "lint": "npm run lint --workspace @secretleaf/web",
    "typecheck": "npm run typecheck --workspace @secretleaf/web",
    "legacy:api:build": "npm run build --workspace @secretleaf/api",
    "legacy:api:typecheck": "npm run typecheck --workspace @secretleaf/api",
    "status:update": "node scripts/status_probe.mjs --output=status-data.json",
    "status:update:local": "node scripts/status_probe.mjs --api=http://localhost:3000/api --web=http://localhost:3000 --output=status-data.json",
    "status:watch": "node scripts/status_probe.mjs --watch --interval=30000 --output=status-data.json",
    "status:ensure": "bash scripts/status_ensure_running.sh",
    "status:autostart:install": "bash scripts/status_autostart_install.sh",
    "status:autostart:show": "crontab -l",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "changelog:dry-run": "node scripts/generate-changelog.mjs --dry-run",
    "coverage:snapshot": "node scripts/update-coverage-history.mjs",
    "fertilizers:prices:sync": "node scripts/sync-fertilizer-prices.mjs",
    "fertilizers:prices:sync:quick": "PRICE_SYNC_LIMIT=30 node scripts/sync-fertilizer-prices.mjs",
    "fertilizers:prices:autostart:install": "bash scripts/fertilizer_prices_autostart_install.sh",
    "fertilizers:prices:autostart:show": "crontab -l",
    "wiki:studies:sync": "node scripts/sync-wiki-studies.mjs",
    "wiki:studies:sync:quick": "STUDY_LOOKBACK_DAYS=45 STUDY_LIMIT=90 node scripts/sync-wiki-studies.mjs",
    "wiki:studies:validate": "node scripts/validate-auto-sources.mjs",
    "wiki:studies:report": "node scripts/generate-wiki-sync-report.mjs",
    "pests:images:check": "node scripts/validate-pest-images.mjs",
    "prebuild": "npm run changelog:generate && npm run coverage:snapshot"
  },
  "overrides": {
    "effect": ">=3.20.0",
    "hono": ">=4.13.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.58.0",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "supabase": "^2.108.0-beta.4"
  }
}
