# API
JWT_SECRET=change-me-with-openssl-rand
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=file:./dev.db
ACCESS_TOKEN_TTL=15m

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=change-me-long-random-string
SMOKE_USER_MAX_AGE_HOURS=24
STUDY_SYNC_LOOKBACK_DAYS=3
STUDY_SYNC_MAX_ATTEMPTS=3

# PubMed / NCBI E-utilities (optional — improves rate limit from 3 to 10 req/s)
NCBI_API_KEY=
# Contact email sent to NCBI with every request (recommended; use a real address)
NCBI_CONTACT_EMAIL=research@yoursite.de
